# safecheck-pharos — a2a-x402 demo configuration.
# Copy to .env and fill in. Target chain: Pharos testnet (eip155:688689).
#
# SECURITY: use DEDICATED THROWAWAY testnet wallets only — never a funded
# mainnet key. The real demo wallets live outside this repo
# (../safecheck-skill/.env.*) and are gitignored.

# ── Seller (audit server) ───────────────────────────────────────────────
PORT=4021
AUDIT_PRICE=0.001                 # price per audit, in USDC
PAY_TO_ADDRESS=0xYourSellerPayoutAddress

# ── Self-hosted x402 facilitator (verifies + settles payments; pays gas) ─
FACILITATOR_PORT=4022
FACILITATOR_URL=http://localhost:4022
# Funds PHRS gas on Pharos testnet. Throwaway key only.
FACILITATOR_PRIVATE_KEY=0xYOUR_FACILITATOR_TESTNET_PRIVATE_KEY

# ── Caller (buyer) ──────────────────────────────────────────────────────
# Holds testnet USDC to pay for audits. Throwaway key only.
CALLER_PRIVATE_KEY=0xYOUR_CALLER_TESTNET_PRIVATE_KEY
SERVER_URL=http://localhost:4021
TARGETS=0xContractToAudit1,0xContractToAudit2
ROUNDS=1
